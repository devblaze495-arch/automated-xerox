# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:4000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:blaze@localhost:5432/campus_print_db?schema=public

# Redis for BullMQ & Caching
REDIS_URL=redis://localhost:6379

# Shared Secret for Operator Android Terminal Gateway
AGENT_SECRET=campus_secret_key_123

# Document Local / Mock Storage Path
UPLOAD_STORAGE_DIR=./uploads


# Self-Hosted UPI Gateway (mynkdev-21/upi-gateway)
UPI_GATEWAY_URL=http://localhost:8000
UPI_GATEWAY_API_KEY=upi_key_campus_test
UPI_GATEWAY_API_SECRET=upi_secret_campus_test
UPI_GATEWAY_WEBHOOK_SECRET=upi_webhook_secret_test



