{
  "name": "@campus-print/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready Fastify backend and WebSocket gateway for Campus Print Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/services/pricing.service.test.ts src/services/printer.service.test.ts src/services/payment.service.test.ts src/services/subscription.service.test.ts src/services/storage.service.test.ts src/services/analytics.service.test.ts src/services/notification.service.test.ts src/services/admin.test.ts",
    "test:e2e": "tsx src/e2e-simulation.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "campus-print",
    "fastify",
    "typescript",
    "prisma",
    "websocket",
    "bullmq"
  ],
  "author": "CampusPrint Engineering Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.14.0",
    "bullmq": "^5.7.9",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.8",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "pino-pretty": "^13.2.0",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}